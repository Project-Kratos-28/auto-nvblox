// zenoh-bridge-ros2dds on the rover (Orin). Started by kratos_nvblox_bringup (run_zenoh:=True).
//
// ROS 2 on the rover stays on DDS, local to the Orin (ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST).
// This bridge is the only thing that talks over the radio link: it forwards the allow-listed
// topics below to Zenoh, where the base station either runs its own bridge (ROS 2 there sees
// the same topic names) or reads them directly with zenoh-python (no ROS needed).
//
// Base station:  zenoh-bridge-ros2dds -c base_station.json5   (connects to the rover)
{
  mode: "router",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  // WLAN: no multicast scouting; the base station connects to the rover's IP explicitly.
  scouting: { multicast: { enabled: false } },

  plugins: {
    ros2dds: {
      domain: 0,
      ros_automatic_discovery_range: "LOCALHOST",
      // Only these cross the link. Heavy full-rate topics (depth, images, the 12 Hz costmap)
      // stay onboard; the throttled /remote/* copies are published by kratos_nvblox_bringup.
      allow: {
        publishers: [
          "/remote/costmap",                 // OccupancyGrid, remote_costmap_hz
          "/remote/color/compressed",        // JPEG, remote_image_hz
          "/remote/esdf_slice/cloudini",     // Cloudini-compressed ESDF slice, remote_esdf_hz
          "/tf", "/tf_static",
          "/zed/zed_node/odom", "/visual_slam/tracking/odometry",
          "/local_costmap/published_footprint",
          "/ess/latency_ms",
        ],
        // Base station -> rover (e.g. goals, teleop). Empty: nothing is accepted yet.
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },
      // Safety net on top of the /remote/* throttles (downsampled when routed to Zenoh).
      pub_max_frequencies: ["/tf=30", "/zed/zed_node/odom=20", "/visual_slam/tracking/odometry=20",
                            "/local_costmap/published_footprint=2", "/ess/latency_ms=2"],
    },
  },

  transport: {
    unicast: {
      // lz4 on the link: the costmap (mostly free space) and point clouds compress well.
      // Both ends must enable it.
      compression: { enabled: true },
    },
  },
}
